# Public URL backend Laravel API.
# Untuk local bisa pakai http://localhost:8000
# Untuk server production ganti ke domain/subdomain API Anda.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public URL backend untuk akses file /storage.
# Biasanya sama dengan API base URL.
NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://localhost:8000
